{
  "name": "@xenosite/forest",
  "version": "0.10.2",
  "description": "Metabolic Forest — chematic Phase I search and rules (JS/WASM)",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "S. Joshua Swamidass <swamidass@gmail.com>",
  "homepage": "https://github.com/swamidasslab/xenosite-forest",
  "bugs": {
    "url": "https://github.com/swamidasslab/xenosite-forest/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swamidasslab/xenosite-forest.git",
    "directory": "js"
  },
  "keywords": [
    "chemistry",
    "metabolism",
    "smiles",
    "wasm",
    "xenosite",
    "forest"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "dist/**/*.wasm",
    "!dist/**/*.smoke.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:wasm": "../scripts/build_wasm.sh",
    "build:ts": "tsc -p tsconfig.json",
    "build:copy-wasm": "bash scripts/copy-wasm.sh",
    "build": "npm run build:wasm && npm run build:ts && npm run build:copy-wasm",
    "check": "tsc -p tsconfig.json --noEmit --strict",
    "test:smoke": "tsx src/api.smoke.ts",
    "test": "npm run check && npm run test:smoke",
    "prepack": "npm run build:ts && npm run build:copy-wasm"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
