  "@graph": [
    {
      "id": "xrm:scheme",
      "type": "skos:ConceptScheme",
      "prefLabel": "Xenobiotic Reaction Metabolism",
      "iri": "https://xenosite.org/ontology/xrm#",
      "definition": "XRM tags each reaction with many terms from parallel, cross-cutting spines aligned to med-chem faceting: metabolism phase, chemical transformation, phase I reaction family (Rainbow), phase II conjugation family, medchem liability, reactive metabolite family, site type, structural delta, product status, rule provenance, evidence, biological context, plus ambiguity and Metabolic Forest map (alias spine)."
    },
    {
      "id": "xrm:0000000",
      "type": "skos:Concept",
      "prefLabel": "xenobiotic biotransformation",
      "inScheme": "xrm:scheme",
      "definition": "Chemical alteration of an exogenous substance in a biological system.",
      "altLabel": [
        "xenobiotic metabolism",
        "biotransformation",
        "drug metabolism"
      ],
      "topConcept": true
    },
    {
      "id": "xrm:0000001",
      "type": "skos:Concept",
      "prefLabel": "phase I",
      "inScheme": "xrm:scheme",
      "definition": "Functionalization: oxidation, reduction, hydrolysis, and related edits that introduce or expose polar groups.",
      "altLabel": [
        "phase 1",
        "functionalization",
        "Metabolic Detoxication, Phase I",
        "phase 1 metabolism",
        "functionalization phase"
      ],
      "broader": "xrm:1000000",
      "relatedMatch": "xrm:9000018"
    },
    {
      "id": "xrm:0000002",
      "type": "skos:Concept",
      "prefLabel": "phase II",
      "inScheme": "xrm:scheme",
      "definition": "Conjugation with hydrophilic moieties (glucuronide, sulfate, glutathione, acetyl, methyl, amino acids, …).",
      "altLabel": [
        "phase 2",
        "conjugation",
        "Metabolic Detoxication, Phase II",
        "phase 2 metabolism",
        "conjugation phase"
      ],
      "broader": "xrm:1000000"
    },
    {
      "id": "xrm:0000003",
      "type": "skos:Concept",
      "prefLabel": "phase III transport",
      "inScheme": "xrm:scheme",
      "definition": "Transporter-mediated disposition related to xenobiotic handling; related to metabolism naming but not a primary reaction label.",
      "altLabel": [
        "phase 3",
        "phase III",
        "transport phase"
      ],
      "broader": "xrm:1000000"
    },
    {
      "id": "xrm:0000010",
      "type": "skos:Concept",
      "prefLabel": "stable oxygenation",
      "inScheme": "xrm:scheme",
      "definition": "Rainbow Phase I class: oxygenation that yields a stable oxygenated metabolite (aromatic/aliphatic hydroxylation, epoxidation, N-oxidation, S-oxidation).",
      "altLabel": [
        "SO class",
        "stable oxygen addition class",
        "Rainbow stable oxygenation",
        "SO class (full name)",
        "stable_oxygenation"
      ],
      "broader": "xrm:1200000",
      "relatedMatch": "xrm:9000010"
    },
    {
      "id": "xrm:0000011",
      "type": "skos:Concept",
      "prefLabel": "unstable oxygenation",
      "inScheme": "xrm:scheme",
      "definition": "Rainbow Phase I class: oxygenation that triggers cleavage or rearrangement (N-/O-/S-/C-dealkylation, oxidative deamination, oxidative dehalogenation).",
      "altLabel": [
        "UO class",
        "unstable oxygen addition class",
        "Rainbow unstable oxygenation",
        "UO class (full name)",
        "unstable_oxygenation"
      ],
      "broader": "xrm:1200000",
      "relatedMatch": "xrm:9000011"
    },
    {
      "id": "xrm:0000012",
      "type": "skos:Concept",
      "prefLabel": "dehydrogenation",
      "inScheme": "xrm:scheme",
      "definition": "Phase I class that extracts hydrogen(s) to form a multiple bond, iminium, or quinoid (alcohol→carbonyl, bond unsaturation, quinone/imine/methide formation, iminium formation). Maps to the Metabolic Forest / Rainbow dehydrogenation ruleset; prefer this full name over localized abbreviations.",
      "altLabel": [
        "desaturation"
      ],
      "broader": [
        "xrm:1100000",
        "xrm:0000001",
        "xrm:1200000"
      ],
      "relatedMatch": [
