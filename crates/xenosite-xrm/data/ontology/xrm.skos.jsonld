      "id": "xrm:8000007",
      "type": "skos:Concept",
      "prefLabel": "arene oxide pathway",
      "inScheme": "xrm:scheme",
      "definition": "Passage through an arene oxide / NIH-shift manifold on an aromatic ring.",
