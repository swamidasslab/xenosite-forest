.envrc
# Caches and virtualenvs
.venv/
# Multi-version bench matrices — use `uv run --python 3.X` instead.
.venvs/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.ruff_cache/
.mypy_cache/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.python-version

# Build artifacts
build/
dist/
target/
src/xenosite/forest/_version.py

# Editors and OS
.vscode/
.idea/
.DS_Store
*.swp
*.bak

# Secrets and local env
.env
.env.*

# Local mailbox between agents. Not a release artifact.
agent-exchange/

# Living SSSOM is uncompressed TSV under mappings/; build.rs gzips to OUT_DIR.
mappings/**/*.gz
*.sssom.tsv.gz

# Local data (never ship). Keep tests/data/ — shared coverage SoT fixtures.
data/
!tests/data/
_api
.cenv
.devcontainer

# Local run artifacts and logs (never ship)
artifacts/
*.live.log
*.err
*.out
# maturin develop may drop the extension beside sources
*.so
*.pyd
*.dylib

# JS / WASM package
node_modules/
js/node_modules/
js/dist/
js/src/wasm/
