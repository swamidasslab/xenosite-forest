    {
      "id": "xrm:6000000",
      "type": "skos:Concept",
      "prefLabel": "ambiguity and underspecification",
      "inScheme": "xrm:scheme",
      "definition": "Cross-cutting spine for incomplete, conflicting, or underdetermined naming evidence. Prefer specific ambiguity subtypes; tag alongside positive terms rather than replacing them.",
      "broader": "xrm:0000000"
    },
    {
      "id": "xrm:6000001",
      "type": "skos:Concept",
      "prefLabel": "ambiguous reaction",
      "inScheme": "xrm:scheme",
      "definition": "Broad flag: more than one incompatible reading remains open.",
      "altLabel": [
        "underspecified reaction"
      ],
      "broader": "xrm:6000000"
    },
    {
      "id": "xrm:6000010",
      "type": "skos:Concept",
      "prefLabel": "site-of-metabolism ambiguity",
      "inScheme": "xrm:scheme",
      "definition": "Which atom or bond is the SOM is not uniquely determined.",
      "broader": "xrm:6000000"
    },
    {
      "id": "xrm:6000011",
      "type": "skos:Concept",
      "prefLabel": "regiochemical ambiguity",
      "inScheme": "xrm:scheme",
      "definition": "Multiple regioisomeric sites remain plausible.",
      "broader": [
        "xrm:6000000",
        "xrm:6000010"
      ],
      "relatedMatch": "xrm:6000001"
    },
    {
      "id": "xrm:6000012",
      "type": "skos:Concept",
      "prefLabel": "stereochemical ambiguity",
      "inScheme": "xrm:scheme",
      "definition": "Stereo outcome (or stereo of the site) is not specified.",
      "broader": [
        "xrm:6000000",
        "xrm:6000010"
      ],
      "relatedMatch": "xrm:6000001"
    },
    {
      "id": "xrm:6000020",
      "type": "skos:Concept",
      "prefLabel": "reaction-type ambiguity",
      "inScheme": "xrm:scheme",
      "definition": "Multiple reaction-type labels remain compatible with the evidence.",
      "broader": "xrm:6000000"
    },
    {
      "id": "xrm:6000021",
      "type": "skos:Concept",
      "prefLabel": "competing-type ambiguity",
      "inScheme": "xrm:scheme",
      "definition": "Two or more named types actively compete (e.g. epoxidation vs aromatic hydroxylation via arene oxide).",
      "broader": [
        "xrm:6000000",
        "xrm:6000020"
      ],
      "relatedMatch": "xrm:6000001"
    },
    {
      "id": "xrm:6000022",
      "type": "skos:Concept",
      "prefLabel": "mechanism ambiguity",
      "inScheme": "xrm:scheme",
      "definition": "Overall type may be clear but the mechanistic path is not (e.g. NIH-shift vs direct insertion).",
      "broader": [
        "xrm:6000000",
        "xrm:6000020"
      ],
      "relatedMatch": "xrm:6000001"
    },
    {
      "id": "xrm:6000030",
      "type": "skos:Concept",
      "prefLabel": "metabolite-structure underspecification",
      "inScheme": "xrm:scheme",
      "definition": "Product structure is incomplete (missing stereo, tautomer, or connectivity detail).",
      "broader": "xrm:6000000"
    },
    {
      "id": "xrm:6000031",
      "type": "skos:Concept",
      "prefLabel": "atom-mapping underspecification",
      "inScheme": "xrm:scheme",
      "definition": "Atom map is missing, partial, or inconsistent, blocking site-level tags.",
      "broader": [
        "xrm:6000000",
        "xrm:6000030"
      ],
      "relatedMatch": "xrm:6000001"
    },
    {
      "id": "xrm:6000032",
      "type": "skos:Concept",
      "prefLabel": "formula-only evidence",
      "inScheme": "xrm:scheme",
      "definition": "Only formula/delta evidence is available; connectivity change is not grounded.",
      "broader": [
        "xrm:6000000",
        "xrm:6000030"
      ],
      "relatedMatch": "xrm:6000001"
    },
    {
      "id": "xrm:6000040",
      "type": "skos:Concept",
      "prefLabel": "pathway-depth ambiguity",
      "inScheme": "xrm:scheme",
      "definition": "Unclear whether the observed change is one-step or requires intermediates.",
      "broader": "xrm:6000000",
      "relatedMatch": "xrm:0000308"
    },
    {
      "id": "xrm:6000041",
      "type": "skos:Concept",
      "prefLabel": "intermediate underspecification",
      "inScheme": "xrm:scheme",
      "definition": "A multi-step path is implied but intermediate structures are not specified.",
      "broader": [
        "xrm:6000000",
        "xrm:6000040"
      ],
      "relatedMatch": "xrm:6000001"
    },
    {
      "id": "xrm:6000050",
      "type": "skos:Concept",
      "prefLabel": "phase ambiguity",
      "inScheme": "xrm:scheme",
      "definition": "Unclear whether the step is best typed as phase I, phase II, or neither.",
      "broader": "xrm:6000000"
    },
    {
      "id": "xrm:6000051",
      "type": "skos:Concept",
      "prefLabel": "forest-map correspondence ambiguity",
      "inScheme": "xrm:scheme",
      "definition": "Chemist typing and Metabolic Forest rule/pattern correspondence are unresolved or conflicting.",
      "broader": [
        "xrm:6000000",
        "xrm:6000001"
      ],
      "relatedMatch": "xrm:6000001"
    },
    {
      "id": "xrm:6000052",
      "type": "skos:Concept",
      "prefLabel": "external-ontology alignment ambiguity",
      "inScheme": "xrm:scheme",
      "definition": "Mapping to MeSH/MOP/KEGG (or similar) is uncertain; keep XRM term and mark alignment soft.",
      "broader": [
        "xrm:6000000",
        "xrm:6000001"
      ],
      "relatedMatch": "xrm:6000001"
    },
    {
      "id": "xrm:6000060",
      "type": "skos:Concept",
      "prefLabel": "aromatic-impact ambiguity",
      "inScheme": "xrm:scheme",
      "definition": "Impact on aromatic/conjugated systems is unclear (preserve vs dearomatize vs quinoid).",
      "broader": [
        "xrm:6000000",
        "xrm:6000001"
      ],
      "relatedMatch": "xrm:6000001"
    },
    {
      "id": "xrm:6000061",
      "type": "skos:Concept",
      "prefLabel": "electrophile-role ambiguity",
      "inScheme": "xrm:scheme",
      "definition": "Whether the step generates or consumes an electrophile is unclear.",
      "broader": [
        "xrm:6000000",
        "xrm:6000001"
      ],
      "relatedMatch": "xrm:6000001"
    },
    {
      "id": "xrm:6000070",
      "type": "skos:Concept",
      "prefLabel": "provenance underspecification",
