      "id": "xrm:8000006",
      "type": "skos:Concept",
      "prefLabel": "heteroaromatic oxidation impact",
      "inScheme": "xrm:scheme",
      "definition": "Oxidation paths that specifically perturb heteroaromatic rings (e.g. thiophene S-oxidation or epoxidation).",
      "broader": "xrm:8000000",
      "relatedMatch": [
        "xrm:0000133",
        "xrm:0000113"
      ]
    },
