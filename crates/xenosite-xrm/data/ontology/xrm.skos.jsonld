  "@graph": [
    {
      "id": "xrm:scheme",
      "type": "skos:ConceptScheme",
      "prefLabel": "Xenobiotic Reaction Metabolism",
      "iri": "https://xenosite.org/ontology/xrm#"
    },
    {
      "id": "xrm:0000000",
      "type": "skos:Concept",
      "prefLabel": "xenobiotic biotransformation",
      "inScheme": "xrm:scheme",
      "altLabel": [
        "xenobiotic metabolism",
        "biotransformation",
        "drug metabolism"
      ],
      "definition": "Chemical alteration of an exogenous substance in a biological system.",
      "topConcept": true
    },
    {
      "id": "xrm:0000001",
      "type": "skos:Concept",
      "prefLabel": "phase I",
      "inScheme": "xrm:scheme",
      "altLabel": [
        "phase 1",
        "functionalization",
        "Metabolic Detoxication, Phase I"
      ],
      "definition": "Functionalization: oxidation, reduction, hydrolysis, and related edits that introduce or expose polar groups.",
      "broader": "xrm:0000000"
    },
    {
      "id": "xrm:0000002",
      "type": "skos:Concept",
      "prefLabel": "phase II",
      "inScheme": "xrm:scheme",
      "altLabel": [
        "phase 2",
        "conjugation",
        "Metabolic Detoxication, Phase II"
      ],
      "definition": "Conjugation with hydrophilic moieties (glucuronide, sulfate, glutathione, acetyl, methyl, amino acids, …).",
      "broader": "xrm:0000000"
    },
    {
      "id": "xrm:0000010",
      "type": "skos:Concept",
      "prefLabel": "stable oxygenation",
      "inScheme": "xrm:scheme",
      "definition": "Phase I class in which oxygen is added and a single observable metabolite results (hydroxylation, aromatic/aliphatic epoxidation, nitrogen oxidation, sulfur oxidation). Maps to the Metabolic Forest / Rainbow stable-oxygenation ruleset; prefer this full name over localized abbreviations.",
      "broader": "xrm:0000001"
    },
    {
      "id": "xrm:0000011",
      "type": "skos:Concept",
      "prefLabel": "unstable oxygenation",
      "inScheme": "xrm:scheme",
      "definition": "Phase I class in which oxygenation destabilizes a heavy-atom bond that then cleaves (N-/O-/S-/C-dealkylation, oxidative deamination, oxidative dehalogenation). Maps to the Metabolic Forest / Rainbow unstable-oxygenation ruleset; prefer this full name over localized abbreviations.",
      "broader": "xrm:0000001"
    },
    {
      "id": "xrm:0000012",
      "type": "skos:Concept",
      "prefLabel": "dehydrogenation",
      "inScheme": "xrm:scheme",
      "altLabel": "desaturation",
      "definition": "Phase I class that extracts hydrogen(s) to form a multiple bond, iminium, or quinoid (alcohol→carbonyl, bond unsaturation, quinone/imine/methide formation, iminium formation). Maps to the Metabolic Forest / Rainbow dehydrogenation ruleset; prefer this full name over localized abbreviations.",
      "broader": "xrm:0000001"
    },
    {
      "id": "xrm:0000013",
      "type": "skos:Concept",
      "prefLabel": "hydrolysis",
      "inScheme": "xrm:scheme",
      "definition": "Phase I class in which water addition cleaves amide, ester, ether, or related bonds (including cyanide/nitrile hydrolysis). Maps to the Metabolic Forest / Rainbow hydrolysis ruleset; prefer this full name over localized abbreviations.",
      "broader": "xrm:0000001"
    },
    {
      "id": "xrm:0000014",
      "type": "skos:Concept",
      "prefLabel": "reduction",
      "inScheme": "xrm:scheme",
      "definition": "Phase I class that removes oxygen or adds hydrogen(s) (nitro, carbonyl, and sulfo reduction; reductive dehalogenation; hydrogenation). Maps to the Metabolic Forest / Rainbow reduction ruleset; prefer this full name over localized abbreviations.",
      "broader": "xrm:0000001"
    },
    {
      "id": "xrm:0000020",
      "type": "skos:Concept",
      "prefLabel": "oxidation",
      "inScheme": "xrm:scheme",
      "altLabel": "oxidative metabolism",
      "definition": "Phase I oxidations broadly (carbon and heteroatom).",
      "broader": "xrm:0000001",
      "relatedMatch": [
        "xrm:0000010",
        "xrm:0000011"
      ]
    },
    {
      "id": "xrm:0000021",
